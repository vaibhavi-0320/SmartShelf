

```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartShelf - Decentralized Library</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.min.js"></script>
    <style>
        : root {
            --primary: #ffffff;
            --secondary: #ff69b4;
            --accent: #ffd700;
            --background: #000000;
            --text: #ffffff;
            --border: #ffffff;
            --hover: #ff69b4;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Courier New', monospace;
            background-color: var(--background);
            color: var(--text);
            overflow-x: hidden;
            line-height: 1.6;
        }
        
        #canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }
        
        .page {
            min-height: 100vh;
            position: relative;
            z-index: 10;
            padding-top: 80px;
        }
        
        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background-color: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 2px solid var(--border);
            z-index: 1000;
            padding: 1rem 2rem;
        }
        
        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .logo {
            font-size: 2.5rem;
            font-weight: bold;
            letter-spacing: 1px;
        }
        
        .nav-links {
            display: flex;
            gap: 2rem;
        }
        
        .nav-links a {
            color: var(--text);
            text-decoration: none;
            font-size: 1.1rem;
            transition: color 0.3s;
        }
        
        .nav-links a:hover {
            color: var(--hover);
        }
        
        .wallet-btn {
            background: transparent;
            border: 2px solid var(--border);
            color: var(--text);
            padding: 0.5rem 1rem;
            font-family: inherit;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .wallet-btn:hover {
            background-color: var(--border);
            color: var(--background);
        }
        
        .wallet-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background-color: rgba(255, 255, 255, 0.1);
            padding: 0.5rem 1rem;
            border-radius: 4px;
        }
        
        .wallet-info .status {
            width: 8px;
            height: 8px;
            background-color: #4ade80;
            border-radius: 50%;
        }
        
        /* Common Styles */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        
        .page-title {
            font-size: 4rem;
            font-weight: bold;
            margin-bottom: 2rem;
            text-align: center;
            letter-spacing: 2px;
        }
        
        .tagline {
            font-size: 1.5rem;
            text-align: center;
            margin-bottom: 3rem;
            color: var(--secondary);
        }
        
        .pixel-btn {
            background: transparent;
            border: 2px solid var(--border);
            color: var(--text);
            padding: 0.75rem 1.5rem;
            font-family: inherit;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .pixel-btn:hover {
            background-color: var(--border);
            color: var(--background);
        }
        
        .pixel-input {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid var(--border);
            background: transparent;
            color: var(--text);
            font-family: inherit;
            font-size: 1rem;
            margin-bottom: 1rem;
        }
        
        .pixel-input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }
        
        .pixel-card {
            border: 2px solid var(--border);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        
        /* Home Page */
        .hero {
            text-align: center;
            padding: 4rem 0;
        }
        
        .book-display {
            width: 300px;
            height: 200px;
            margin: 0 auto 2rem;
            background: linear-gradient(45deg, var(--secondary), var(--accent));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: bold;
            position: relative;
        }
        
        .stats {
            display: flex;
            justify-content: center;
            gap: 3rem;
            margin: 3rem 0;
            flex-wrap: wrap;
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-value {
            font-size: 2rem;
            font-weight: bold;
            color: var(--secondary);
        }
        
        .stat-label {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.7);
            text-transform: uppercase;
        }
        
        .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }
        
        .book-card {
            border: 2px solid var(--border);
            padding: 1rem;
            text-align: center;
            transition: border-color 0.3s;
        }
        
        .book-card:hover {
            border-color: var(--hover);
        }
        
        .book-cover {
            width: 100%;
            height: 150px;
            background: linear-gradient(45deg, var(--secondary), var(--accent));
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            color: var(--background);
            font-weight: bold;
        }
        
        .book-title {
            font-size: 1.1rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }
        
        .book-author {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 1rem;
        }
        
        .book-price {
            font-size: 0.9rem;
            margin-right: 0.5rem;
        }
        
        .buy-btn {
            background: transparent;
            border: 2px solid var(--border);
            color: var(--text);
            padding: 0.25rem 0.5rem;
            font-family: inherit;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .buy-btn:hover {
            background-color: var(--border);
            color: var(--background);
        }
        
        /* Library Page */
        .search-container {
            max-width: 500px;
            margin: 0 auto 2rem;
            position: relative;
        }
        
        .search-input {
            width: 100%;
            padding: 0.75rem 0.75rem 0.75rem 2.5rem;
            border: 2px solid var(--border);
            background: transparent;
            color: var(--text);
            font-family: inherit;
            font-size: 1rem;
        }
        
        .search-icon {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--border);
        }
        
        /* Author Panel */
        .author-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }
        
        .upload-form .form-group {
            margin-bottom: 1rem;
        }
        
        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
            text-transform: uppercase;
        }
        
        .uploaded-books {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
        
        .uploaded-book {
            border: 2px solid var(--border);
            padding: 1rem;
        }
        
        .uploaded-cover {
            width: 100%;
            height: 80px;
            background: linear-gradient(45deg, var(--secondary), var(--accent));
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.6rem;
            color: var(--background);
            font-weight: bold;
        }
        
        /* Profile Page */
        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }
        
        .purchased-books {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
        
        /* Footer */
        footer {
            background-color: rgba(0, 0, 0, 0.9);
            border-top: 2px solid var(--border);
            padding: 2rem 0;
            margin-top: 4rem;
        }
        
        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }
        
        .footer-links a {
            color: var(--text);
            text-decoration: none;
            margin-left: 1.5rem;
            transition: color 0.3s;
        }
        
        .footer-links a:hover {
            color: var(--hover);
        }
        
        /* Success Message */
        .success-message {
            position: fixed;
            top: 20px;
            right: 20px;
            background-color: #10b981;
            color: white;
            padding: 1rem 1.5rem;
            border: 2px solid white;
            z-index: 2000;
            animation: fadeInOut 3s forwards;
        }
        
        @keyframes fadeInOut {
            0% { opacity: 0; transform: translateX(100px); }
            10% { opacity: 1; transform: translateX(0); }
            90% { opacity: 1; transform: translateX(0); }
            100% { opacity: 0; transform: translateX(100px); }
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .page-title {
                font-size: 2.5rem;
            }
            
            .author-grid,
            .profile-grid {
                grid-template-columns: 1fr;
            }
            
            .books-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            }
            
            .nav-links {
                display: none;
            }
            
            .footer-content {
                flex-direction: column;
                text-align: center;
            }
            
            .footer-links {
                margin-top: 1rem;
            }
            
            .footer-links a {
                margin: 0 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav id="navigation">
        <div class="nav-container">
            <div class="logo">SmartShelf</div>
            <div class="nav-links">
                <a href="#" class="nav-link" data-page="home">Home</a>
                <a href="#" class="nav-link" data-page="library">Library</a>
                <a href="#" class="nav-link" data-page="author">Author Panel</a>
                <a href="#" class="nav-link" data-page="profile">Profile</a>
                <a href="#" class="nav-link" data-page="credits">Credits</a>
                <a href="#" class="nav-link" data-page="terms">Terms</a>
            </div>
            <button id="connect-wallet" class="wallet-btn">Connect Wallet</button>
            <div id="wallet-info" class="wallet-info" style="display: none;">
                <span id="wallet-address">0x71C...976F</span>
                <div class="status"></div>
            </div>
        </div>
    </nav>

    <!-- Canvas for 3D effects -->
    <div id="canvas-container"></div>

    <!-- Pages -->
    <div id="home" class="page active">
        <div class="container">
            <div class="hero">
                <h1 class="page-title">SmartShelf</h1>
                <p class="tagline">Fighting Piracy. Rewarding <span style="color: #ff69b4;">Creators</span>. Together.</p>
                <div class="book-display">OPEN BOOK</div>
                <button id="home-connect-btn" class="pixel-btn">Connect Wallet</button>
            </div>
            
            <div class="stats">
                <div class="stat-item">
                    <div class="stat-value">10:00 AM EST</div>
                    <div class="stat-label">SYNCED</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">1,247</div>
                    <div class="stat-label">TOTAL BOOKS</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">8,421</div>
                    <div class="stat-label">ACTIVE USERS</div>
                </div>
            </div>
            
            <h2 class="page-title" style="font-size: 2.5rem; margin-top: 4rem;">FEATURED BOOKS</h2>
            <div class="books-grid" id="featured-books">
                <!-- Books will be populated by JavaScript -->
            </div>
        </div>
        <footer>
            <div class="footer-content">
                <div>© 2023 SmartShelf. All rights reserved.</div>
                <div class="footer-links">
                    <a href="#" class="nav-link" data-page="credits">Credits</a>
                    <a href="#" class="nav-link" data-page="terms">Terms & Conditions</a>
                </div>
            </div>
        </footer>
    </div>

    <div id="library" class="page">
        <div class="container">
            <h1 class="page-title">LIBRARY</h1>
            <div class="search-container">
                <input type="text" id="search-input" class="search-input" placeholder="Search books...">
            </div>
            <div class="books-grid" id="all-books">
                <!-- Books will be populated by JavaScript -->
            </div>
        </div>
        <footer>
            <div class="footer-content">
                <div>© 2023 SmartShelf. All rights reserved.</div>
                <div class="footer-links">
                    <a href="#" class="nav-link" data-page="credits">Credits</a>
                    <a href="#" class="nav-link" data-page="terms">Terms & Conditions</a>
                </div>
            </div>
        </footer>
    </div>

    <div id="author" class="page">
        <div class="container">
            <h1 class="page-title">AUTHOR PANEL</h1>
            <div class="author-grid">
                <div class="pixel-card">
                    <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">UPLOAD NEW BOOK</h2>
                    <form id="upload-form">
                        <div class="form-group">
                            <label class="form-label">Title</label>
                            <input type="text" id="book-title" class="pixel-input" placeholder="Enter book title">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Description</label>
                            <input type="text" id="book-description" class="pixel-input" placeholder="Enter book description">
                        </div>
                        <div class="form-group">
                            <label class="form-label">File URL</label>
                            <input type="text" id="book-url" class="pixel-input" placeholder="Enter file URL">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Price (ETH)</label>
                            <input type="number" id="book-price" class="pixel-input" placeholder="0.05" step="0.01" min="0.01">
                        </div>
                        <button type="submit" class="pixel-btn">UPLOAD</button>
                    </form>
                </div>
                <div class="pixel-card">
                    <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">YOUR UPLOADED BOOKS</h2>
                    <div class="uploaded-books" id="uploaded-books">
                        <!-- Uploaded books will be populated by JavaScript -->
                    </div>
                </div>
            </div>
        </div>
        <footer>
            <div class="footer-content">
                <div>© 2023 SmartShelf. All rights reserved.</div>
                <div class="footer-links">
                    <a href="#" class="nav-link" data-page="credits">Credits</a>
                    <a href="#" class="nav-link" data-page="terms">Terms & Conditions</a>
                </div>
            </div>
        </footer>
    </div>

    <div id="profile" class="page">
        <div class="container">
            <h1 class="page-title">PROFILE PAGE</h1>
            <div class="profile-grid">
                <div class="pixel-card">
                    <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">YOUR DETAILS</h2>
                    <div style="margin-bottom: 1rem;">
                        <div style="font-size: 0.9rem; color: rgba(255,255,255,0.7); margin-bottom: 0.5rem;">WALLET ADDRESS:</div>
                        <div id="profile-wallet-address">0xFa...8aB3</div>
                    </div>
                    <button class="pixel-btn">VIEW TRANSACTION HISTORY</button>
                </div>
                <div class="pixel-card">
                    <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">PURCHASED BOOKS</h2>
                    <div class="purchased-books" id="purchased-books">
                        <!-- Purchased books will be populated by JavaScript -->
                    </div>
                </div>
            </div>
        </div>
        <footer>
            <div class="footer-content">
                <div>© 2023 SmartShelf. All rights reserved.</div>
                <div class="footer-links">
                    <a href="#" class="nav-link" data-page="credits">Credits</a>
                    <a href="#" class="nav-link" data-page="terms">Terms & Conditions</a>
                </div>
            </div>
        </footer>
    </div>

    <div id="credits" class="page">
        <div class="container">
            <h1 class="page-title">CREDITS & CREATION</h1>
            <div class="pixel-card">
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">CREATED BY</h2>
                <div style="margin-bottom: 2rem;">
                    <p style="font-size: 1.2rem; margin-bottom: 0.5rem;">Anna Kai</p>
                    <p style="color: rgba(255,255,255,0.7);">Founder & Lead Developer</p>
                </div>
                
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">DESIGN TEAM</h2>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem;">
                    <div class="pixel-card" style="padding: 1rem;">
                        <p style="font-weight: bold;">Design Director</p>
                        <p style="color: rgba(255,255,255,0.7);">Alex Chen</p>
                    </div>
                    <div class="pixel-card" style="padding: 1rem;">
                        <p style="font-weight: bold;">UI/UX Designer</p>
                        <p style="color: rgba(255,255,255,0.7);">Jamie Rodriguez</p>
                    </div>
                </div>
                
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">DEVELOPMENT TEAM</h2>
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 2rem;">
                    <div class="pixel-card" style="padding: 1rem;">
                        <p style="font-weight: bold;">Frontend Lead</p>
                        <p style="color: rgba(255,255,255,0.7);">Sam Wilson</p>
                    </div>
                    <div class="pixel-card" style="padding: 1rem;">
                        <p style="font-weight: bold;">Blockchain Engineer</p>
                        <p style="color: rgba(255,255,255,0.7);">Taylor Kim</p>
                    </div>
                    <div class="pixel-card" style="padding: 1rem;">
                        <p style="font-weight: bold;">QA Specialist</p>
                        <p style="color: rgba(255,255,255,0.7);">Jordan Lee</p>
                    </div>
                </div>
                
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">THANK YOU</h2>
                <p style="margin-bottom: 1rem;">
                    Special thanks to our community of creators and readers who make SmartShelf possible.
                    Your support helps us continue to fight piracy and reward creators fairly.
                </p>
                <div style="display: flex; gap: 0.5rem;">
                    <div style="width: 20px; height: 20px; background-color: #3b82f6; border-radius: 50%; animation: pulse 2s infinite;"></div>
                    <div style="width: 20px; height: 20px; background-color: #10b981; border-radius: 50%; animation: pulse 2s infinite 0.5s;"></div>
                    <div style="width: 20px; height: 20px; background-color: #8b5cf6; border-radius: 50%; animation: pulse 2s infinite 1s;"></div>
                </div>
            </div>
        </div>
        <footer>
            <div class="footer-content">
                <div>© 2023 SmartShelf. All rights reserved.</div>
                <div class="footer-links">
                    <a href="#" class="nav-link" data-page="credits">Credits</a>
                    <a href="#" class="nav-link" data-page="terms">Terms & Conditions</a>
                </div>
            </div>
        </footer>
    </div>

    <div id="terms" class="page">
        <div class="container">
            <h1 class="page-title">TERMS & CONDITIONS</h1>
            <div class="pixel-card">
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">1. ACCEPTANCE OF TERMS</h2>
                <p style="margin-bottom: 1rem;">
                    By accessing or using SmartShelf, you agree to be bound by these Terms and Conditions. If you do not agree to these terms, you may not use our services.
                </p>
                
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">2. USER ACCOUNTS</h2>
                <p style="margin-bottom: 1rem;">
                    You must create an account to access certain features of SmartShelf. You are responsible for maintaining the confidentiality of your account credentials.
                </p>
                
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">3. INTELLECTUAL PROPERTY</h2>
                <p style="margin-bottom: 1rem;">
                    All content on SmartShelf, including but not limited to text, graphics, logos, and software, is the property of SmartShelf or its licensors and is protected by copyright and other intellectual property laws.
                </p>
                
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">4. PAYMENTS AND FEES</h2>
                <p style="margin-bottom: 1rem;">
                    All payments on SmartShelf are processed using cryptocurrency. Prices are displayed in ETH and are subject to change without notice.
                </p>
                
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">5. LIMITATION OF LIABILITY</h2>
                <p style="margin-bottom: 1rem;">
                    SmartShelf shall not be liable for any indirect, incidental, special, consequential or punitive damages resulting from your use of or inability to use the service.
                </p>
                
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">6. CHANGES TO TERMS</h2>
                <p style="margin-bottom: 1rem;">
                    We reserve the right to modify these Terms at any time. Changes will be effective immediately upon posting on this page.
                </p>
                
                <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">7. CONTACT US</h2>
                <p style="margin-bottom: 1rem;">
                    If you have any questions about these Terms, please contact us at support@smartshelf.com
                </p>
                
                <button class="pixel-btn">I AGREE TO THESE TERMS</button>
            </div>
        </div>
        <footer>
            <div class="footer-content">
                <div>© 2023 SmartShelf. All rights reserved.</div>
                <div class="footer-links">
                    <a href="#" class="nav-link" data-page="credits">Credits</a>
                    <a href="#" class="nav-link" data-page="terms">Terms & Conditions</a>
                </div>
            </div>
        </footer>
    </div>

    <script>
        // Mock data
        const mockBooks = [
            { id: 1, title: "THE ETHER SAGA", author: "ANNA KAI", price: "0.05", cover: "MLIR" },
            { id: 2, title: "THE ETHER SAGA", author: "ANNA KAI", price: "0.05", cover: "ANE+KAI" },
            { id: 3, title: "THE ETHER SAGA", author: "ANNA KAI", price: "0.05", cover: "FRCAL" },
            { id: 4, title: "THE TITLE", author: "ANNA KAI", price: "0.05", cover: "BOMIN" },
            { id: 5, title: "THE ETHER SAGA", author: "ANNA KAI", price: "0.05", cover: "MILK" },
            { id: 6, title: "THER SAGA", author: "ANNA KAI", price: "0.05", cover: "THER+SAGA" },
            { id: 7, title: "STERI BCS", author: "ANNA KAI", price: "0.05", cover: "STERI+BCS" },
            { id: 8, title: "THE ETHER", author: "ANNA KAI", price: "0.05", cover: "THE+ETHER" }
        ];

        const mockPurchases = [
            { id: 1, title: "THE TITLE", author: "ANNA KAI", price: "0.05" },
            { id: 2, title: "THE ETHER SAGA", author: "ANNA KAI", price: "0.05" },
            { id: 3, title: "THER SAGA", author: "ANNA KAI", price: "0.05" }
        ];

        const mockUploads = [
            { id: 1, title: "THER SAGA", author: "ANNA KAI", price: "0.05", earnings: "0.15" },
            { id: 2, title: "THE ETHER SAGA", author: "ANNA KAI", price: "0.05", earnings: "0.15" },
            { id: 3, title: "MILK", author: "ANNA KAI", price: "0.05", earnings: "0.15" }
        ];

        // State
        let walletConnected = false;
        let walletAddress = "0x71C7656EC7ab88b098defB751B7401B5f6d8976F";
        let currentPage = 'home';

        // DOM Elements
        const pages = document.querySelectorAll('.page');
        const navLinks = document.querySelectorAll('.nav-link');
        const connectWalletBtn = document.getElementById('connect-wallet');
        const homeConnectBtn = document.getElementById('home-connect-btn');
        const walletInfo = document.getElementById('wallet-info');
        const walletAddressEl = document.getElementById('wallet-address');
        const profileWalletAddress = document.getElementById('profile-wallet-address');
        const searchInput = document.getElementById('search-input');
        const uploadForm = document.getElementById('upload-form');

        // Initialize
        function init() {
            populateBooks();
            setupEventListeners();
            init3D();
        }

        // Populate books
        function populateBooks() {
            const featuredBooks = document.getElementById('featured-books');
            const allBooks = document.getElementById('all-books');
            const purchasedBooks = document.getElementById('purchased-books');
            const uploadedBooks = document.getElementById('uploaded-books');

            // Featured books (first 6)
            featuredBooks.innerHTML = '';
            mockBooks.slice(0, 6).forEach(book => {
                featuredBooks.appendChild(createBookCard(book));
            });

            // All books
            allBooks.innerHTML = '';
            mockBooks.forEach(book => {
                allBooks.appendChild(createBookCard(book));
            });

            // Purchased books
            purchasedBooks.innerHTML = '';
            mockPurchases.forEach(purchase => {
                const book = mockBooks.find(b => b.title === purchase.title) || { cover: "BOOK" };
                purchasedBooks.appendChild(createPurchasedBookCard(purchase, book.cover));
            });

            // Uploaded books
            uploadedBooks.innerHTML = '';
            mockUploads.forEach(upload => {
                const book = mockBooks.find(b => b.title === upload.title) || { cover: "BOOK" };
                uploadedBooks.appendChild(createUploadedBookCard(upload, book.cover));
            });
        }

        // Create book card
        function createBookCard(book) {
            const card = document.createElement('div');
            card.className = 'book-card';
            card.innerHTML = `
                <div class="book-cover">${book.cover}</div>
                <div class="book-title">${book.title}</div>
                <div class="book-author">BY ${book.author}</div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="book-price">${book.price} ETH</span>
                    <button class="buy-btn">Buy / Access</button>
                </div>
            `;
            return card;
        }

        // Create purchased book card
        function createPurchasedBookCard(purchase, cover) {
            const card = document.createElement('div');
            card.className = 'uploaded-book';
            card.innerHTML = `
                <div class="uploaded-cover">${cover}</div>
                <div class="book-title">${purchase.title}</div>
                <div class="book-author">BY ${purchase.author}</div>
                <button class="pixel-btn" style="font-size: 0.8rem; padding: 0.25rem 0.5rem;">READ / DOWNLOAD</button>
            `;
            return card;
        }

        // Create uploaded book card
        function createUploadedBookCard(upload, cover) {
            const card = document.createElement('div');
            card.className = 'uploaded-book';
            card.innerHTML = `
                <div class="uploaded-cover">${cover}</div>
                <div class="book-title">${upload.title}</div>
                <div class="book-author">BY ${upload.author}</div>
                <div style="color: #ff69b4; font-size: 0.8rem;">EARNINGS: ${upload.earnings} ETH 🍊</div>
            `;
            return card;
        }

        // Setup event listeners
        function setupEventListeners() {
            // Navigation
            navLinks.forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    const page = link.getAttribute('data-page');
                    showPage(page);
                });
            });

            // Wallet connection
            connectWalletBtn.addEventListener('click', connectWallet);
            homeConnectBtn.addEventListener('click', connectWallet);

            // Search
            searchInput.addEventListener('input', (e) => {
                const searchTerm = e.target.value.toLowerCase();
                const bookCards = document.querySelectorAll('#all-books .book-card');
                bookCards.forEach(card => {
                    const title = card.querySelector('.book-title').textContent.toLowerCase();
                    const author = card.querySelector('.book-author').textContent.toLowerCase();
                    if (title.includes(searchTerm) || author.includes(searchTerm)) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });

            // Upload form
            uploadForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const title = document.getElementById('book-title').value;
                if (title) {
                    alert(`Book "${title}" uploaded successfully!`);
                    document.getElementById('book-title').value = '';
                    document.getElementById('book-description').value = '';
                    document.getElementById('book-url').value = '';
                    document.getElementById('book-price').value = '';
                }
            });
        }

        // Connect wallet
        function connectWallet() {
            walletConnected = true;
            document.getElementById('connect-wallet').style.display = 'none';
            document.getElementById('home-connect-btn').style.display = 'none';
            walletInfo.style.display = 'flex';
            walletAddressEl.textContent = walletAddress.substring(0, 6) + '...' + walletAddress.substring(walletAddress.length - 4);
            profileWalletAddress.textContent = walletAddress;
            
            // Show success message
            const successMsg = document.createElement('div');
            successMsg.className = 'success-message';
            successMsg.textContent = 'Wallet connected successfully!';
            document.body.appendChild(successMsg);
            
            setTimeout(() => {
                if (document.body.contains(successMsg)) {
                    document.body.removeChild(successMsg);
                }
            }, 3000);
        }

        // Show page
        function showPage(page) {
            pages.forEach(p => {
                p.classList.remove('active');
                p.style.display = 'none';
            });
            document.getElementById(page).classList.add('active');
            document.getElementById(page).style.display = 'block';
            currentPage = page;
        }

        // 3D Scene Initialization
        function init3D() {
            const container = document.getElementById('canvas-container');
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
            
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            container.appendChild(renderer.domElement);
            
            // Add lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
            scene.add(ambientLight);
            
            const pointLight1 = new THREE.PointLight(0xffffff, 1);
            pointLight1.position.set(10, 10, 10);
            scene.add(pointLight1);
            
            const pointLight2 = new THREE.PointLight(0x4f46e5, 0.5);
            pointLight2.position.set(-10, -10, -10);
            scene.add(pointLight2);
            
            // Create cursor follower
            const cursorGeometry = new THREE.SphereGeometry(0.3, 16, 16);
            const cursorMaterial = new THREE.MeshBasicMaterial({ 
                color: 0xffffff, 
                transparent: true, 
                opacity: 0.7 
            });
            const cursorMesh = new THREE.Mesh(cursorGeometry, cursorMaterial);
            scene.add(cursorMesh);
            
            // Create floating books
            const books = [];
            const bookData = [
                { position: [-3, 2, 0], text: "ETHER SAGA" },
                { position: [3, -2, 0], text: "TITLE" },
                { position: [0, 0, 0], text: "MILK" }
            ];
            
            bookData.forEach(data => {
                const bookGroup = new THREE.Group();
                bookGroup.position.set(...data.position);
                
                const bookGeometry = new THREE.BoxGeometry(1.2, 1.6, 0.2);
                const bookMaterial = new THREE.MeshBasicMaterial({ 
                    color: 0xffffff, 
                    transparent: true, 
                    opacity: 0.8 
                });
                const bookMesh = new THREE.Mesh(bookGeometry, bookMaterial);
                bookGroup.add(bookMesh);
                
                scene.add(bookGroup);
                books.push({ group: bookGroup, time: Math.random() * Math.PI * 2 });
            });
            
            // Mouse position tracking
            let mouseX = 0, mouseY = 0;
            document.addEventListener('mousemove', (event) => {
                mouseX = (event.clientX / window.innerWidth) * 2 - 1;
                mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
            });
            
            // Animation loop
            const clock = new THREE.Clock();
            function animate() {
                requestAnimationFrame(animate);
                
                const elapsedTime = clock.getElapsedTime();
                
                // Update cursor follower position
                cursorMesh.position.x = mouseX * 5;
                cursorMesh.position.y = mouseY * 3;
                
                // Animate floating books
                books.forEach((book, index) => {
                    book.group.rotation.y = elapsedTime * 0.2 + index * 0.1;
                    book.group.position.y = book.group.position.y + Math.sin(elapsedTime + index) * 0.01;
                });
                
                // Add subtle camera movement
                camera.position.z = 10 + Math.sin(elapsedTime * 0.1) * 0.5;
                
                renderer.render(scene, camera);
            }
            
            // Handle window resize
            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
            
            camera.position.z = 10;
            animate();
        }

        // Initialize when DOM is loaded
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
```

